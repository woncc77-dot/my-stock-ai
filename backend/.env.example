# Google AI Studio API 키
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# CORS 허용 Origin (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Supabase JWT Secret (Dashboard → Project Settings → API → JWT Secret)
# 프로덕션에서는 반드시 설정하세요. 미설정 상태로 배포하면 인증이 503으로 거부됩니다(fail-closed).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 로컬 개발 전용: JWT Secret 없이 인증을 건너뛰려면 true로 설정.
# 프로덕션에는 절대 설정하지 마세요(무인증 개방 위험).
ALLOW_DEV_AUTH_BYPASS=false
