# Google AI Studio API 키
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# CORS 허용 Origin (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Supabase 인증 (둘 중 하나 이상 설정해야 프로덕션 인증이 동작합니다)
#
# 1) 최신 프로젝트(비대칭 ES256/RS256 서명키 사용) → SUPABASE_URL 설정 권장.
#    백엔드가 {SUPABASE_URL}/auth/v1/.well-known/jwks.json 공개키로 토큰을 검증합니다.
SUPABASE_URL=https://your-project-ref.supabase.co
#
# 2) 레거시 프로젝트(HS256 공유 시크릿) → JWT Secret 설정.
#    (Dashboard → Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
#
# 둘 다 미설정 상태로 배포하면 모든 인증 요청이 503으로 거부됩니다(fail-closed).

# 로컬 개발 전용: JWT Secret 없이 인증을 건너뛰려면 true로 설정.
# 프로덕션에는 절대 설정하지 마세요(무인증 개방 위험).
ALLOW_DEV_AUTH_BYPASS=false
